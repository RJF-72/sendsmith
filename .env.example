# SendSmith configuration — copy to .env and fill in.
# Every value has a working default for local development EXCEPT where
# noted. Production (NODE_ENV=production) fails fast on dangerous
# combinations — see server/validateConfig.js.

# --- Core ---
# "production" or "development". Production disables redis-mock and
# requires real storage (below).
NODE_ENV=development
# Public URL of this deployment (used for links/redirects).
BASE_URL=http://localhost:1443
IP_ADDRESS=0.0.0.0
PORT=1443
# Local file storage directory (used when no S3/GCS bucket is set).
# Must be persistent in production.
FILE_DIR=./data

# --- Redis (metadata, accounts, sessions, rate limits) ---
# Use "mock" ONLY for local development/tests — production refuses it.
REDIS_HOST=mock
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Blob storage: S3-compatible (AWS S3, Cloudflare R2, Backblaze B2, MinIO) ---
S3_BUCKET=
# e.g. https://<accountid>.r2.cloudflarestorage.com — empty = AWS
S3_ENDPOINT=
S3_REGION=us-east-1
# true for R2/B2/MinIO-style providers that need path-style URLs
S3_USE_PATH_STYLE_ENDPOINT=false
# AWS credentials are read by the SDK's standard chain
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / instance role).

# --- Blob storage: Google Cloud Storage (alternative to S3) ---
GCS_BUCKET=

# --- Limits: account tier ---
MAX_FILE_SIZE=2684354560
MAX_EXPIRE_SECONDS=604800
MAX_DOWNLOADS=100
DEFAULT_EXPIRE_SECONDS=86400
EXPIRE_TIMES_SECONDS=
DOWNLOAD_COUNTS=
MAX_FILES_PER_ARCHIVE=64
MAX_ARCHIVES_PER_USER=16

# --- Limits: anonymous tier (deliberately tighter) ---
ANON_MAX_FILE_SIZE=209715200
ANON_MAX_EXPIRE_SECONDS=86400
ANON_MAX_DOWNLOADS=5

# --- Accounts ---
SESSION_TTL_SECONDS=2592000
# Monthly transfer quota per account tier (bytes). 0 = unlimited.
FREE_MONTHLY_QUOTA_BYTES=2147483648
PRO_MONTHLY_QUOTA_BYTES=214748364800

# --- Rate limits (per IP, fixed window) ---
RATELIMIT_UPLOAD_MAX=30
RATELIMIT_UPLOAD_WINDOW_SECONDS=3600
RATELIMIT_DOWNLOAD_MAX=600
RATELIMIT_DOWNLOAD_WINDOW_SECONDS=3600
RATELIMIT_REPORT_MAX=10
RATELIMIT_REPORT_WINDOW_SECONDS=86400
RATELIMIT_AUTH_MAX=30
RATELIMIT_AUTH_WINDOW_SECONDS=3600

# --- Bot gate: Cloudflare Turnstile (optional; both or neither) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- Payments: Stripe (optional; all three or none — Pro tier hidden otherwise) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Telemetry: strictly opt-in, off by default, no vendor calls when unset ---
# Your own Sentry instance DSN (server) — never Mozilla's.
SENTRY_DSN=
SENTRY_HOST=
# Browser Sentry key (public identifier from YOUR Sentry project).
SENTRY_CLIENT=
AMPLITUDE_ID=
GOOGLE_ANALYTICS_ID=

# --- Misc ---
SURVEY_URL=
IP_DB=
L10N_DEV=false
REDIS_EVENT_EXPIRE=false
REDIS_RETRY_TIME=10000
REDIS_RETRY_DELAY=500
